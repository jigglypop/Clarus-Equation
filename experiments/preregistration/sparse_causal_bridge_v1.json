    "bridge_basis": "tanh(x_source)",
    "ridge": 0.001,
    "directed_edge_budget": 2,
    "causal_effect_abs_min": 0.15,
    "causal_z_min": 3.0,
    "require_split_half_sign_agreement": true,
    "observational_gain_min_fraction": 0.01,
    "truth_labels_available_to_selector": false,
    "final_observational_fit_uses_test_rows": false,
    "probe_use": "causal_bridge and dense_probe use topology probes; probe labels are not reused as validation/test effects"
  },
  "models": [
    "local_only",
    "dense_observational",
    "raw_correlation_top2",
    "predictive_gain_top2",
    "geometry_observational_top2",
    "dense_probe",
    "causal_bridge",
    "oracle_diagnostic"
