{
  "schema_version": 1,
  "status": "locked_pre_implementation",
  "registered_on": "2026-08-10",
  "experiment": "sparse_causal_bridge_v1",
  "roadmap_stage": "G9-CB",
  "hypothesis": "A discrete Laplace-Beltrami fold-contact prior can propose a small undirected bridge set, while randomized paired interventions can prune and orient that set into an invariant sparse causal world model under a registered hidden-cause loading shift.",
  "claim_boundary": "This is a four-chart synthetic engineering gate. Geometry is a proposal prior, not causal evidence, and the experiment does not establish a cortical sulcus, U-fiber, neural, AGI, or biological mechanism.",
  "matrix_orientation": "bridge[target, source]",
  "charts": ["A", "B", "C", "D"],
  "scm": {
    "equations": {
      "latent": "h[t+1] = latent_ar * h[t] + latent_noise_std * xi[t]",
      "observed": "x[t+1] = self_coeff * x[t] + bridge @ tanh(x[t]) + loading[environment] * h[t] + state_noise_std * epsilon[t]"
    },
    "latent_ar": 0.96,
    "latent_noise_std": 0.12,
    "state_noise_std": 0.1,
    "initial_state_std": 0.25,
    "self_coefficients": [0.14, 0.12, 0.78, 0.76],
    "true_directed_bridges": [
      {"source": 0, "target": 2, "coefficient": 0.52},
      {"source": 2, "target": 3, "coefficient": -0.48}
    ],
    "train_hidden_loadings": [1.15, 1.25, 0.55, 0.0],
    "ood_hidden_loadings": [1.15, -1.25, -0.55, 0.0],
    "registered_common_cause_pair": [0, 1],
    "burn_in_steps": 100
  },
  "geometry_proposal": {
    "interpretation": "A four-node finite graph is only a discrete Laplace-Beltrami surrogate for an intrinsically long but extrinsically close folded sheet.",
    "surface_edges": [
      [0, 3, 1.0],
      [3, 1, 1.0],
      [1, 2, 1.0]
    ],
    "white_contact_affinity": [
      [0.0, 1.0, 0.95, 0.25],
      [1.0, 0.0, 0.22, 0.68],
      [0.95, 0.22, 0.0, 0.92],
      [0.25, 0.68, 0.92, 0.0]
    ],
    "heat_time": 0.5,
    "score": "white_contact_affinity * (1 - normalized_off_diagonal_heat_kernel)",
    "undirected_pair_budget": 4,
    "directed_expansion": "both orientations",
    "required_truth_pair_coverage": 1.0
  },
  "data_roles": {
    "observational_train": {
      "environment": "train",
      "seeds": [5100, 5101, 5102, 5103, 5104, 5105, 5106, 5107],
      "steps_per_seed": 520
    },
    "observational_selector_holdout": {
      "environment": "train",
      "seeds": [5600, 5601, 5602, 5603],
      "steps_per_seed": 360
    },
    "topology_intervention_probe": {
      "environment": "train",
      "seeds": [6100, 6101, 6102, 6103],
      "stationary_steps_per_seed": 320,
      "pairs_per_source_per_seed": 32
    },
    "validation": {
      "environment": "ood",
      "seeds": [7100, 7101, 7102, 7103, 7104, 7105, 7106, 7107, 7108, 7109, 7110, 7111, 7112, 7113, 7114, 7115, 7116, 7117, 7118, 7119],
      "steps_per_seed": 360,
      "intervention_pairs_per_source_per_seed": 24
    },
    "test": {
      "environment": "ood",
      "seeds": [8100, 8101, 8102, 8103, 8104, 8105, 8106, 8107, 8108, 8109, 8110, 8111, 8112, 8113, 8114, 8115, 8116, 8117, 8118, 8119, 8120, 8121, 8122, 8123, 8124, 8125, 8126, 8127, 8128, 8129],
      "steps_per_seed": 360,
      "intervention_pairs_per_source_per_seed": 24
    }
  },
  "intervention": {
    "operation": "surgically replace one source x_j by +amplitude and -amplitude from the same base state and hidden state",
    "amplitude": 0.75,
    "common_process_noise_within_pair": true,
    "independent_sensor_noise_std": 0.04,
    "balanced_source_and_sign_order": true,
    "rng_streams": "state, process, intervention_order, and sensor streams are separated by fixed offsets"
  },
  "learning": {
