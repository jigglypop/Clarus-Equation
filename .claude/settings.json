{
  "permissions": {
    "allow": [
      "Bash(.claude/hooks/python.cmd *)",
      "Bash(.claude\\hooks\\python.cmd *)",
      "Bash(cmd /d /c .claude\\hooks\\python.cmd *)",
      "Bash(python .claude/hooks/lib/*)",
      "Bash(python verify/**)",
      "Read",
      "Grep",
      "Glob",
      "Write",
      "Edit",
      "MultiEdit",
      "WebSearch",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:scholar.google.com)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Write(.git/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /d /c \".claude\\hooks\\session-start.cmd\"",
            "timeout": 20,
            "statusMessage": "Loading research ledger summary"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /d /c \".claude\\hooks\\goal-reminder.cmd\"",
            "timeout": 10,
            "statusMessage": "Injecting current research target"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /d /c \".claude\\hooks\\check-large-data.cmd\"",
            "timeout": 30,
            "statusMessage": "Checking commit/push for data payloads"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /d /c \".claude\\hooks\\write-gate.cmd\"",
            "timeout": 20,
            "statusMessage": "Checking write path policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /d /c \".claude\\hooks\\verify-on-save.cmd\"",
            "timeout": 90,
            "statusMessage": "Verifying derivation file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /d /c \".claude\\hooks\\ledger-or-block.cmd\"",
            "timeout": 30,
            "statusMessage": "Checking ledger entry for current attempt"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /d /c \".claude\\hooks\\ledger-or-block.cmd\"",
            "timeout": 30,
            "statusMessage": "Checking ledger entry for current attempt"
          }
        ]
      }
    ]
  }
}
